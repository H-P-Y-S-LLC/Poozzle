{
  "name": "matchface-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MatchFace (变脸大作战) Three.js web port — zero external assets. See ../Documents/ThreeJsWebPortDevDoc.md",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
